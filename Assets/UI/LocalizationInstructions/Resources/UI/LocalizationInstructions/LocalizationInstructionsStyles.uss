/* ============================================
   Localization Instructions - Enhanced Mobile UI
   ============================================ */

.localization-instructions-panel {
    position: absolute;
    left: 50%;
    top: 8%;
    translate: -50% 0;
    width: 90%;
    max-width: 700px;
    background-color: rgba(20, 25, 40, 0.96);
    border-radius: 28px;
    border-width: 3px;
    border-color: rgba(100, 200, 255, 0.5);
    padding: 12px 12px 16px 12px;
    display: none; /* Hidden by default */
    flex-direction: column;
    align-items: center;
    transition-property: opacity;
    transition-duration: 0.3s;
}

/* ============================================
   Compact Bar (Collapsed State)
   ============================================ */

.loc-compact-bar {
    width: 100%;
    min-height: 64px; /* Thumb-friendly */
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(20, 25, 40, 0.0);
    border-radius: 18px;
    padding: 12px 16px;
}

.mini-loading-spinner {
    width: 36px;
    height: 36px;
    margin-right: 12px;
    justify-content: center;
    align-items: center;
}

.mini-spinner-ring {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border-width: 5px;
    border-color: transparent;
    border-top-color: rgb(100, 200, 255);
    border-right-color: rgb(100, 200, 255);
}

.loc-compact-text {
    font-size: 28px;
    color: rgb(230, 240, 255);
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.loc-expand-icon {
    font-size: 36px;
    color: rgb(180, 220, 255);
    margin-left: 12px;
}

/* ============================================
   Expandable Body
   ============================================ */

.loc-body {
    width: 100%;
    margin-top: 8px;
    padding: 24px 20px 28px 20px;
    background-color: rgba(20, 25, 40, 0.96);
    border-radius: 20px;
    border-width: 2px;
    border-color: rgba(100, 200, 255, 0.35);
    display: none; /* Collapsed by default */
}

/* ============================================
   Header Section (Spinner Container)
   ============================================ */

.instructions-header {
    width: 100%;
    flex-direction: column;
    align-items: center;
    margin-bottom: 24px;
}

/* Loading Spinner */
.loading-spinner {
    width: 80px;
    height: 80px;
    margin-bottom: 0;
    justify-content: center;
    align-items: center;
}

.spinner-ring {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border-width: 7px;
    border-color: transparent;
    border-top-color: rgb(100, 200, 255);
    border-right-color: rgb(100, 200, 255);
    /* Note: UI Toolkit doesn't support CSS animations */
    /* Animated in C# using schedule.Execute */
}

/* ============================================
   Main Instructions Label
   ============================================ */

.instructions-label {
    font-size: 38px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 0 0 32px 0;
    padding: 0;
    -unity-font-style: bold;
    /* line-height not supported in Unity UI Toolkit - removed */
}

/* ============================================
   Step-by-Step Instructions
   ============================================ */

.instructions-steps {
    width: 100%;
    flex-direction: column;
    margin-bottom: 28px;
}

.instruction-step {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 20px;
    padding: 16px 20px;
    background-color: rgba(30, 40, 60, 0.6);
    border-radius: 16px;
    border-width: 2px;
    border-color: rgba(100, 200, 255, 0.25);
}

.step-number {
    width: 48px;
    height: 48px;
    min-width: 48px;
    min-height: 48px;
    background-color: rgba(100, 200, 255, 0.9);
    border-radius: 24px;
    font-size: 32px;
    color: rgb(10, 15, 25);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-right: 18px;
    flex-shrink: 0;
}

.step-text {
    font-size: 30px;
    color: rgb(230, 240, 255);
    -unity-text-align: middle-left;
    white-space: normal;
    flex-grow: 1;
    flex-shrink: 1;
    padding-top: 8px;
}

/* ============================================
   Help Tip Section
   ============================================ */

.instructions-tip {
    width: 100%;
    flex-direction: row;
    align-items: center;
    padding: 20px 24px;
    background-color: rgba(50, 120, 200, 0.15);
    border-radius: 18px;
    border-width: 2px;
    border-color: rgba(100, 200, 255, 0.35);
}

.tip-icon {
    font-size: 36px;
    margin-right: 16px;
    flex-shrink: 0;
}

.tip-text {
    font-size: 26px;
    color: rgb(180, 220, 255);
    -unity-text-align: middle-left;
    white-space: normal;
    flex-grow: 1;
    -unity-font-style: italic;
}
