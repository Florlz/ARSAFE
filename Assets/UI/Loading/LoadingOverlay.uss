/* ==================== ROOT OVERLAY ==================== */
.loading-overlay {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: var(--overlay-bg);
    overflow: hidden;
}

/* ==================== BACKGROUND GLOWS ==================== */
.bg-glow,
.bg-glow-1,
.bg-glow-2,
.bg-glow-3 {
    display: none;
}

/* ==================== CARD CONTAINER ==================== */
.card-container {
    width: 100%;
    max-width: 520px;
    padding: 20px;
    margin-left: auto;
    margin-right: auto;
}

.card-glass {
    padding: 48px 40px;
    border-radius: 32px;
    background-color: var(--glass-bg);
    border-width: 1.5px;
    border-color: var(--glass-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Note: backdrop-filter not supported in Unity UI Toolkit, effect simulated with translucent colors */
}

/* ==================== LOGO SECTION ==================== */
.logo-section {
    position: relative;
    margin-bottom: 32px;
    display: flex;
    justify-content: center;
    align-items: center;
}

.logo-glow {
    position: absolute;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    /* Note: radial-gradient not fully supported, using solid color instead */
    background-color: var(--logo-glow-center);
    opacity: 0.3;
}

.logo-image {
    width: 120px;
    height: 120px;
    border-radius: 24px;
    background-color: transparent;
    -unity-background-scale-mode: scale-to-fit;
    position: relative;
}

/* ==================== STATUS SECTION ==================== */
.status-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 28px;
    width: 100%;
}

.status-primary {
    font-size: 28px;
    color: var(--text-primary);
    margin-bottom: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
    text-shadow: 0 8px 24px var(--text-shadow);
}

.status-secondary {
    font-size: 15px;
    color: var(--text-secondary);
    -unity-text-align: middle-center;
    opacity: 0.9;
    white-space: normal;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
}

/* ==================== ELEGANT DIVIDER ==================== */
.divider {
    width: 100%;
    height: 2px;
    margin: 20px 0 32px 0;
    position: relative;
    display: none; /* HIDDEN - Removed violet line above progress bar */
    justify-content: center;
}

.divider-line {
    position: absolute;
    width: 100%;
    height: 1px;
    /* Note: linear-gradient simplified for Unity UI Toolkit */
    background-color: var(--divider-color);
    opacity: 0; /* HIDDEN */
}

.divider-glow {
    position: absolute;
    width: 60%;
    height: 4px;
    background-color: var(--divider-glow);
    opacity: 0; /* HIDDEN */
}

/* ==================== PROGRESS SECTION ==================== */
.progress-section {
    width: 100%;
    display: flex;
    flex-direction: column;
    padding-top: 8px;
    padding-bottom: 8px;
    /* Note: 'gap' not supported in Unity UI Toolkit */
}

/* Modern Progress Bar Container */
.progress-container {
    position: relative;
    width: 100%;
    height: 16px; /* INCREASED from 8px - Taller progress bar */
    border-radius: 12px;
    overflow: hidden;
    margin-top: 8px;
    margin-bottom: 8px;
}

.custom-progress {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 12px;
    margin: 0;
    padding: 0;
    border-width: 0;
}

.custom-progress > .unity-progress-bar__background {
    background-color: var(--progress-track);
    border-radius: 12px;
    height: 100%;
    margin: 0;
    padding: 0;
}

.custom-progress > .unity-progress-bar__progress {
    /* Note: linear-gradient simplified for Unity UI Toolkit */
    background-color: var(--progress-gradient-mid);
    border-radius: 12px;
    height: 100%;
    margin: 0;
    padding: 0;
}

.custom-progress > .unity-progress-bar__container {
    height: 100%;
    margin: 0;
    padding: 0;
}

/* Shimmer Animation Effect */
.progress-shimmer {
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background-color: var(--shimmer-color);
    opacity: 0.4;
}

/* Progress Info Row */
.progress-info {
    display: flex;
    flex-direction: row;
    align-items: center; /* Changed from 'baseline' - not supported in Unity UI Toolkit */
    justify-content: center;
    padding-left: 4px;
    padding-right: 4px;
    margin-top: 8px;
    margin-bottom: 8px;
    /* Note: 'gap' not supported in Unity UI Toolkit */
}

.percent-text {
    font-size: 32px;
    color: var(--progress-text-primary);
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: nowrap;
    margin-left: 4px;
    margin-right: 4px;
}

.ready-text {
    font-size: 16px;
    color: var(--progress-text-secondary);
    -unity-font-style: normal;
    opacity: 0.8;
    white-space: nowrap;
    margin-left: 4px;
    margin-right: 4px;
}

/* ==================== ACTIVATION INFO ==================== */
.activation-info {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 12px 16px;
    border-radius: 12px;
    background-color: var(--activation-bg);
    border-width: 1px;
    border-color: var(--activation-border);
    margin-top: 8px;
    margin-bottom: 8px;
}

.activation-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    min-width: 0;
    /* Note: 'gap' not supported in Unity UI Toolkit */
}

.status-indicator {
    font-size: 12px;
    color: var(--indicator-active);
    margin-right: 8px;
}

.activation-label {
    font-size: 14px;
    color: var(--text-secondary);
    -unity-font-style: normal;
    white-space: normal;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 4px;
    margin-right: 4px;
}

.activation-count {
    font-size: 14px;
    color: var(--accent-color);
    -unity-font-style: bold;
    padding: 4px 12px;
    border-radius: 8px;
    background-color: var(--count-bg);
    white-space: nowrap;
    flex-shrink: 0;
    margin-left: 8px;
}

/* ==================== RESPONSIVE DESIGN ==================== */
@media (max-width: 600px) {
    .card-glass {
        padding: 36px 28px;
        border-radius: 24px;
    }
    
    .logo-image {
        width: 96px;
        height: 96px;
    }
    
    .logo-glow {
        width: 120px;
        height: 120px;
    }
    
    .status-primary {
        font-size: 24px;
    }
    
    .status-secondary {
        font-size: 14px;
    }
    
    .percent-text {
        font-size: 28px;
    }
    
    .ready-text {
        font-size: 14px;
    }
}

@media (max-width: 400px) {
    .card-glass {
        padding: 28px 20px;
        border-radius: 20px;
    }
    
    .logo-image {
        width: 80px;
        height: 80px;
    }
    
    .status-primary {
        font-size: 20px;
    }
    
    .activation-info {
        flex-direction: column;
        align-items: flex-start;
        padding-top: 4px;
        padding-bottom: 4px;
        /* Note: 'gap' not supported in Unity UI Toolkit */
    }
}

/* ==================== ACCESSIBILITY ==================== */
/* Note: prefers-reduced-motion not fully supported in Unity UI Toolkit, kept for future compatibility */
