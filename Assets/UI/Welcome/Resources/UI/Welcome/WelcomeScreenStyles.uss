/* ============================================
   Loading UI Color Scheme - Glassmorphism Navy/Gold
   Matches LoadingColors.uss for visual consistency
   ============================================ */

:root {
    /* Overlay - deep navy/maroon blend (from Loading UI) */
    --welcome-overlay-bg: rgba(14, 4, 16, 0.94);

    /* Card glass palette - dark navy (from Loading UI) */
    --welcome-card-bg: rgba(20, 24, 36, 0.98);
    --welcome-border: rgba(243, 178, 58, 0.38);
    --welcome-highlight: rgba(255, 244, 219, 0.08);

    /* Gold accents (from Loading UI) */
    --welcome-accent: rgba(243, 178, 58, 1);
    --welcome-accent-soft: rgba(243, 178, 58, 0.22);
    --welcome-glow: rgba(217, 118, 40, 0.32);

    /* Typography (from Loading UI) */
    --welcome-text-primary: rgba(255, 244, 219, 0.98);
    --welcome-text-secondary: rgba(255, 214, 123, 0.86);
    --welcome-text-muted: rgba(255, 244, 219, 0.75);
    --welcome-text-shadow: rgba(0, 0, 0, 0.42);

    /* Button colors */
    --welcome-button-primary-bg: rgba(243, 178, 58, 1);
    --welcome-button-primary-text: rgba(20, 24, 36, 1);
    --welcome-button-secondary-bg: rgba(25, 30, 42, 0.68);
    --welcome-button-secondary-border: rgba(243, 178, 58, 0.38);
}

.welcome-overlay {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    display: none;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: var(--welcome-overlay-bg);
    padding: 32px;
}

/* ============================================
   Welcome Card - Mobile-First Design
   ============================================ */

.welcome-card {
    width: 92%;
    max-width: 700px;
    min-width: 0;
    max-height: 92%;
    background-color: var(--welcome-card-bg);
    border-radius: 32px;
    border-width: 2px;
    border-color: var(--welcome-border);
    border-left-width: 6px;
    border-left-color: var(--welcome-accent);
    padding: 0;
    flex-direction: column;
    overflow: hidden;
}

/* ============================================
   ScrollView Container
   ============================================ */

.welcome-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

/* Hide scrollbar track on mobile (cleaner look) */
.welcome-scroll > .unity-scroll-view__content-viewport {
    flex-grow: 1;
}

.welcome-scroll > .unity-scroller--vertical {
    width: 8px;
    margin-right: 4px;
}

.welcome-scroll > .unity-scroller--vertical > .unity-scroller__slider {
    margin: 0;
}

/* Scrollbar styling for mobile visibility */
.welcome-scroll .unity-scroller__low-button,
.welcome-scroll .unity-scroller__high-button {
    display: none;
}

.welcome-scroll .unity-base-slider__dragger {
    background-color: var(--welcome-border);
    border-radius: 4px;
    width: 8px;
}

/* ============================================
   Banner Section
   ============================================ */

.welcome-banner {
    width: 100%;
    height: 220px;
    min-height: 220px;
    /* UI Toolkit: use Unity-specific background scale mode */
    -unity-background-scale-mode: scale-and-crop;
    border-top-left-radius: 32px;
    border-top-right-radius: 32px;
    margin-bottom: 28px;
    background-color: var(--welcome-accent-soft);
    flex-shrink: 0;
}

/* ============================================
   Header Section
   ============================================ */

.welcome-card__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 28px;
    min-width: 0;
    padding-left: 40px;
    padding-right: 40px;
}

.welcome-icon {
    width: 84px;
    height: 84px;
    min-width: 84px;
    border-radius: 42px;
    margin-right: 24px;
    background-color: var(--welcome-accent-soft);
    border-width: 3px;
    border-color: var(--welcome-border);
    flex-shrink: 0;
}

/* ============================================
   Title Section - Mobile-First Typography
   ============================================ */

.welcome-card__titles {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.welcome-title {
    color: var(--welcome-text-primary);
    font-size: 42px;
    -unity-font-style: bold;
    white-space: normal;
    text-shadow: 0 2px 4px var(--welcome-text-shadow);
}

.welcome-scenario {
    color: var(--welcome-text-secondary);
    font-size: 26px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    white-space: normal;
    text-shadow: 0 1px 3px var(--welcome-text-shadow);
}

/* ============================================
   Text Content - Mobile-Friendly Sizing
   ============================================ */

.welcome-text {
    color: var(--welcome-text-muted);
    -unity-text-align: upper-left;
    white-space: normal;
}

.welcome-text--intro {
    font-size: 28px;
    margin-bottom: 24px;
    padding-left: 40px;
    padding-right: 40px;
}

.welcome-text--footer {
    font-size: 26px;
    margin-top: 20px;
    margin-bottom: 24px;
    padding-left: 40px;
    padding-right: 40px;
}

/* ============================================
   Instructions Section
   ============================================ */

.welcome-instructions {
    flex-direction: column;
    margin-bottom: 16px;
    padding-left: 40px;
    padding-right: 40px;
}

.welcome-instructions__item {
    color: var(--welcome-text-primary);
    font-size: 28px;
    padding: 18px 24px;
    margin-bottom: 14px;
    border-radius: 18px;
    background-color: var(--welcome-accent-soft);
    border-left-width: 5px;
    border-left-color: var(--welcome-accent);
    white-space: normal;
}

/* ============================================
   Toggle Checkbox
   ============================================ */

.welcome-toggle {
    margin-bottom: 28px;
    color: var(--welcome-text-muted);
    font-size: 26px;
    padding-left: 40px;
    padding-right: 40px;
}

.welcome-toggle > .unity-toggle__checkmark {
    border-color: var(--welcome-accent);
    width: 32px;
    height: 32px;
    border-width: 2px;
}

.welcome-toggle > .unity-toggle__input {
    margin-right: 16px;
}

/* ============================================
   Action Buttons - Mobile Touch-Friendly
   ============================================ */

.welcome-actions {
    flex-direction: column;
    padding-left: 40px;
    padding-right: 40px;
    padding-bottom: 36px;
}

.welcome-button {
    height: 80px;
    min-height: 80px;
    border-radius: 20px;
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--welcome-text-primary);
    margin-bottom: 16px;
}

.welcome-button--primary {
    background-color: var(--welcome-button-primary-bg);
    color: var(--welcome-button-primary-text);
    border-width: 2px;
    border-color: var(--welcome-accent);
}

.welcome-button--secondary {
    background-color: var(--welcome-button-secondary-bg);
    border-width: 2px;
    border-color: var(--welcome-button-secondary-border);
    color: var(--welcome-text-primary);
}

