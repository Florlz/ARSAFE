:root {
    --fire-alert-bg: rgba(10, 6, 4, 0.94);
    --fire-alert-card: rgba(28, 18, 16, 0.98);
    --fire-alert-banner: rgba(204, 0, 0, 0.95);
    --fire-alert-banner-glow: rgba(255, 69, 0, 0.6);
    --fire-alert-primary: #ff5722;
    --fire-alert-accent: #ffa726;
    --fire-alert-danger: #8b1a00;
    --fire-alert-text: #fff8e1;
    --fire-alert-text-muted: rgba(255, 248, 225, 0.75);
    --fire-alert-border: rgba(255, 167, 38, 0.3);
    --fire-alert-stat-bg: rgba(255, 167, 38, 0.12);
    --fire-alert-action-bg: rgba(255, 87, 34, 0.18);
}

.fire-alert__root {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    display: none;
    justify-content: center;
    align-items: center;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.3s ease, visibility 0.3s ease;
}

.fire-alert__root--visible {
    display: flex;
    visibility: visible;
    opacity: 1;
}

.fire-alert__scrim {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: var(--fire-alert-bg);
}

.fire-alert__card {
    min-width: 340px;
    max-width: 600px;
    width: 88%;
    padding: 0;
    border-radius: 28px;
    background-color: var(--fire-alert-card);
    border-width: 2px;
    border-color: var(--fire-alert-danger);
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.fire-alert__section {
    display: flex;
    flex-direction: column;
    height: 100%;
}

.fire-alert__section--hidden {
    display: none;
}

.fire-alert__banner {
    padding: 16px;
    background-color: var(--fire-alert-banner);
    display: flex;
    justify-content: center;
    align-items: center;
}

.fire-alert__banner-text {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--fire-alert-text);
    letter-spacing: 4px;
}

.fire-alert__body {
    padding: 32px;
    display: flex;
    flex-direction: column;
}

.fire-alert__header {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-bottom: 28px;
}

.fire-alert__icon-container {
    width: 72px;
    height: 72px;
    border-radius: 36px;
    background-color: var(--fire-alert-danger);
    margin-right: 24px;
    justify-content: center;
    align-items: center;
    display: flex;
}

.fire-alert__icon {
    font-size: 44px;
    color: var(--fire-alert-text);
    -unity-text-align: middle-center;
}

.fire-alert__header-text {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.fire-alert__title {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--fire-alert-text);
    margin-bottom: 6px;
    white-space: normal;
}

.fire-alert__subtitle {
    font-size: 20px;
    color: var(--fire-alert-text-muted);
    white-space: normal;
}

.fire-alert__stats {
    display: flex;
    flex-direction: row;
    justify-content: center;
    margin-bottom: 24px;
}

.fire-alert__stat-card {
    flex-grow: 1;
    padding: 20px;
    border-radius: 20px;
    background-color: var(--fire-alert-stat-bg);
    border-width: 2px;
    border-color: var(--fire-alert-border);
    display: flex;
    flex-direction: column;
    align-items: center;
}

.fire-alert__stat-card--alarm {
    border-color: rgba(255, 167, 38, 0.2);
}

.fire-alert__stat-label {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--fire-alert-text-muted);
    letter-spacing: 2px;
    margin-bottom: 8px;
    white-space: normal;
}

.fire-alert__stat-value {
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--fire-alert-accent);
    white-space: normal;
}

.fire-alert__stat-value--large {
    font-size: 42px;
}

.fire-alert__stat-sublabel {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--fire-alert-accent);
    margin-top: 6px;
    -unity-text-align: upper-center;
    white-space: normal;
}

.fire-alert__stat-sublabel-small {
    font-size: 18px;
    color: var(--fire-alert-text-muted);
    margin-top: 4px;
    -unity-text-align: upper-center;
    white-space: normal;
}

.fire-alert__action-box {
    padding: 24px;
    border-radius: 20px;
    background-color: var(--fire-alert-action-bg);
    border-width: 2px;
    border-color: var(--fire-alert-primary);
    display: flex;
    flex-direction: row;
    align-items: flex-start;
}

.fire-alert__action-icon {
    font-size: 38px;
    color: var(--fire-alert-primary);
    -unity-text-align: middle-center;
    margin-right: 16px;
}

.fire-alert__action-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.fire-alert__action-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--fire-alert-accent);
    letter-spacing: 2px;
    margin-bottom: 10px;
}

.fire-alert__action-message {
    font-size: 22px;
    color: var(--fire-alert-text);
    white-space: normal;
}

.fire-alert__button {
    margin: 28px 32px 32px 32px;
    height: 64px;
    border-radius: 32px;
    background-color: var(--fire-alert-danger);
    color: var(--fire-alert-text);
    font-size: 24px;
    -unity-font-style: bold;
    border-color: var(--fire-alert-danger);
    border-width: 0;
    letter-spacing: 1px;
}

.fire-alert__button--secondary {
    background-color: var(--fire-alert-primary);
    border-color: var(--fire-alert-primary);
}

@media (max-width: 520px) {
    .fire-alert__card {
        max-width: 96%;
    }

    .fire-alert__stats {
        flex-direction: column;
    }

    .fire-alert__stat-card--alarm {
        margin: 0 0 16px 0;
    }

    .fire-alert__button {
        margin: 24px 20px 28px 20px;
    }
}
