<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="FireAlertStyles.uss" />
    <ui:VisualElement name="fire-alert-overlay" class="fire-alert__root">
        <ui:VisualElement name="fire-alert-scrim" class="fire-alert__scrim"/>
        <ui:VisualElement name="fire-alert-card" class="fire-alert__card">
            <ui:VisualElement name="fire-alert-start" class="fire-alert__section fire-alert__section--start">
                <ui:VisualElement class="fire-alert__banner">
                    <ui:Label class="fire-alert__banner-text" text="EMERGENCY"/>
                </ui:VisualElement>
                <ui:VisualElement class="fire-alert__body">
                    <ui:VisualElement class="fire-alert__header">
                        <ui:VisualElement class="fire-alert__icon-container">
                            <ui:Label class="fire-alert__icon" text="&#9888;"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="fire-alert__header-text">
                            <ui:Label name="fire-alert-title" class="fire-alert__title" text="Fire Detected"/>
                            <ui:Label class="fire-alert__subtitle" text="Evacuate Immediately"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="fire-alert__stats">
                        <ui:VisualElement class="fire-alert__stat-card fire-alert__stat-card--alarm">
                            <ui:Label class="fire-alert__stat-label" text="ALARM LEVEL"/>
                            <ui:Label name="alarm-level-value" class="fire-alert__stat-value fire-alert__stat-value--large" text="3"/>
                            <ui:Label name="alarm-level-label" class="fire-alert__stat-sublabel" text="3rd Alarm"/>
                            <ui:Label name="response-type-label" class="fire-alert__stat-sublabel-small" text="Neighboring Municipality Support"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="fire-alert__action-box">
                        <ui:Label class="fire-alert__action-icon" text="&#9881;"/>
                        <ui:VisualElement class="fire-alert__action-content">
                            <ui:Label class="fire-alert__action-title" text="SAFETY PROTOCOL"/>
                            <ui:Label name="response-label" class="fire-alert__action-message" text="Stay low, cover mouth, use nearest exit."/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="acknowledge-button" class="fire-alert__button" text="ACKNOWLEDGED"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
