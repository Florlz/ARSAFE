/* ============================================
   ARSAFE - Wrong Way Warning Overlay
   RED PULSING BORDER - EMERGENCY ALERT
   ============================================ */

/* === OVERLAY CONTAINER === */
.warning-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    display: none;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
    /* background-color removed - was causing Unity UI Toolkit bug where RGBA becomes opaque during opacity animation */
    /* Note: pickingMode must be set in C# code, not CSS (warningOverlay.pickingMode = PickingMode.Ignore) */
}

/* === BORDER BASE STYLES === */
.warning-border {
    position: absolute;
    background-color: rgb(255, 50, 50);
    opacity: 0.7;
    /* CSS transitions removed - animation handled by C# coroutine to prevent flickering */
}

/* === TOP BORDER === */
.warning-border--top {
    top: 0;
    left: 0;
    width: 100%;
    height: 12px;
}

/* === RIGHT BORDER === */
.warning-border--right {
    top: 0;
    right: 0;
    width: 12px;
    height: 100%;
}

/* === BOTTOM BORDER === */
.warning-border--bottom {
    bottom: 0;
    left: 0;
    width: 100%;
    height: 12px;
}

/* === LEFT BORDER === */
.warning-border--left {
    top: 0;
    left: 0;
    width: 12px;
    height: 100%;
}

/* === CENTER WARNING MESSAGE (SIMPLIFIED) === */
.wrong-way-message {
    position: absolute;
    width: 100%;
    top: 50%;
    left: 0;
    justify-content: center;
    align-items: center;
    display: none;
    /* No longer fullscreen - just centered horizontally, positioned vertically */
}

.wrong-way-card {
    background-color: rgba(255, 50, 50, 0.95);
    border-radius: 15px;
    border-width: 3px;
    border-color: rgb(255, 255, 255);
    padding: 20px 40px;
    /* Simplified: smaller padding, smaller border */
}

.wrong-way-text {
    font-size: 48px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* Exit switch notification removed - was unused and causing layout issues */
