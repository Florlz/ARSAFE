<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="WrongWayWarningStyles.uss" />

    <!-- Wrong Way Warning Overlay -->
    <ui:VisualElement name="wrong-way-warning-overlay" class="warning-overlay" style="display: none; opacity: 0;">

        <!-- Top Border -->
        <ui:VisualElement class="warning-border warning-border--top" />

        <!-- Right Border -->
        <ui:VisualElement class="warning-border warning-border--right" />

        <!-- Bottom Border -->
        <ui:VisualElement class="warning-border warning-border--bottom" />

        <!-- Left Border -->
        <ui:VisualElement class="warning-border warning-border--left" />

        <!-- Center Warning Message -->
        <ui:VisualElement name="wrong-way-message" class="wrong-way-message">
            <ui:VisualElement class="wrong-way-card">
                <ui:Label text="⚠" class="wrong-way-icon" />
                <ui:Label text="WRONG WAY!" class="wrong-way-title" />
                <ui:Label text="Follow the arrows to the nearest exit" class="wrong-way-subtitle" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Exit Switch Notification (top center) -->
        <ui:VisualElement name="exit-switch-notification" class="exit-switch-notification" style="display: none;">
            <ui:VisualElement class="exit-switch-card">
                <ui:Label text="↻" class="exit-switch-icon" />
                <ui:Label name="exit-switch-label" text="Closer exit found!" class="exit-switch-label" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
