<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="FloodAlertStyles.uss" />
    <ui:VisualElement name="flood-alert-overlay" class="flood-alert__root">
        <ui:VisualElement name="flood-alert-scrim" class="flood-alert__scrim"/>
        <ui:VisualElement name="flood-alert-card" class="flood-alert__card">
            <ui:VisualElement name="flood-alert-start" class="flood-alert__section flood-alert__section--start">
                <ui:VisualElement class="flood-alert__banner">
                    <ui:Label class="flood-alert__banner-text" text="EMERGENCY"/>
                </ui:VisualElement>
                <ui:VisualElement class="flood-alert__body">
                    <ui:VisualElement class="flood-alert__header">
                        <ui:VisualElement class="flood-alert__icon-container">
                            <ui:Label class="flood-alert__icon" text="&#9888;"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="flood-alert__header-text">
                            <ui:Label name="flood-alert-title" class="flood-alert__title" text="Flood Detected"/>
                            <ui:Label class="flood-alert__subtitle" text="Evacuate to Higher Ground"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="flood-alert__stats">
                        <ui:VisualElement class="flood-alert__stat-card flood-alert__stat-card--warning">
                            <ui:Label class="flood-alert__stat-label" text="PAGASA RAINFALL WARNING"/>
                            <ui:Label name="rainfall-warning-value" class="flood-alert__stat-value flood-alert__stat-value--large" text="ORANGE"/>
                            <ui:Label name="rainfall-warning-label" class="flood-alert__stat-sublabel" text="15-30mm/hr - Flooding Expected"/>
                            <ui:Label name="warning-message-label" class="flood-alert__stat-sublabel-small" text="Prepare for evacuation to higher ground"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="flood-alert__action-box">
                        <ui:Label class="flood-alert__action-icon" text="&#9650;"/>
                        <ui:VisualElement class="flood-alert__action-content">
                            <ui:Label class="flood-alert__action-title" text="EVACUATION GUIDANCE"/>
                            <ui:Label name="response-label" class="flood-alert__action-message" text="Move to 2nd floor immediately. Use stairs only."/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="acknowledge-button" class="flood-alert__button" text="ACKNOWLEDGED"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
