/* ============================================
   ARSAFE - Message Notification System
   MOBILE-OPTIMIZED, ATTENTION-GRABBING
   ============================================ */

/* === MESSAGE CONTAINER === */
.message-container {
    position: absolute;
    top: 15%;
    left: 50%;
    translate: -50% 0;
    width: 92%;
    max-width: 950px;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0;
}

/* === MESSAGE ANIMATION === */
.message-notification {
    position: relative;
    width: 100%;
    height: auto;
    margin-bottom: 22px;
    transition-property: opacity, translate, scale;
    transition-duration: 0.35s, 0.35s, 0.35s;
    /* cubic-bezier not supported in Unity UI Toolkit */
    /* transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1); */
    opacity: 1;
    translate: 0 0;
    scale: 1;
}

.message-notification.hidden {
    opacity: 0;
    translate: 0 -40px;
    scale: 0.95;
}

/* === BASE MESSAGE CARD === */
.message-card {
    flex-direction: row;
    align-items: center;
    padding: 32px 36px;
    background-color: rgba(26, 31, 46, 0.98);
    border-radius: 20px;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.15);
    border-left-width: 8px;
    border-left-color: rgb(255, 130, 0);
    margin: 0;
    min-height: 110px;
    /* box-shadow not supported in Unity UI Toolkit */
    /* box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6); */
}

/* === ICON CONTAINER === */
.message-icon {
    width: 80px;
    height: 80px;
    min-width: 80px;
    min-height: 80px;
    margin-right: 28px;
    justify-content: center;
    align-items: center;
    background-color: rgba(255, 130, 0, 0.2);
    border-width: 3px;
    border-radius: 18px;
    border-color: rgba(255, 130, 0, 0.5);
    flex-shrink: 0;
}

.icon-text {
    font-size: 48px;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
    color: rgb(255, 200, 87);
    -unity-font-style: bold;
}

/* === MESSAGE CONTENT === */
.message-content {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.message-label {
    font-size: 36px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: normal;
    margin: 0;
    padding: 0;
    overflow: visible;
}

/* === INFO TYPE (Blue) === */
.message-card.info {
    background-color: rgba(31, 38, 56, 0.98);
    border-left-color: rgb(59, 130, 246);
    border-color: rgba(59, 130, 246, 0.3);
}

.message-card.info .message-icon {
    background-color: rgba(59, 130, 246, 0.2);
    border-color: rgba(59, 130, 246, 0.5);
}

.message-card.info .icon-text {
    color: rgb(147, 197, 253);
}

/* === SUCCESS TYPE (Green) === */
.message-card.success {
    background-color: rgba(20, 40, 30, 0.98);
    border-left-color: rgb(34, 197, 94);
    border-color: rgba(34, 197, 94, 0.3);
}

.message-card.success .message-icon {
    background-color: rgba(34, 197, 94, 0.2);
    border-color: rgba(34, 197, 94, 0.5);
}

.message-card.success .icon-text {
    color: rgb(134, 239, 172);
}

/* === WARNING TYPE (Orange/Yellow) - HIGH VISIBILITY === */
.message-card.warning {
    background-color: rgba(60, 30, 0, 0.98);
    border-left-color: rgb(255, 170, 0);
    border-color: rgba(255, 170, 0, 0.5);
    border-width: 4px;
    border-left-width: 10px;
    /* CSS animations not supported in Unity UI Toolkit - use C# animations instead */
    /* animation-name: pulse-warning; */
    /* animation-duration: 2s; */
    /* animation-iteration-count: infinite; */
    /* animation-timing-function: ease-in-out; */
}

/* @keyframes not supported in Unity UI Toolkit */
/* @keyframes pulse-warning {
    0%, 100% {
        border-left-color: rgb(255, 170, 0);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6), 0 0 0 0 rgba(255, 170, 0, 0.4);
    }
    50% {
        border-left-color: rgb(255, 200, 87);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6), 0 0 20px 5px rgba(255, 170, 0, 0.3);
    }
} */

.message-card.warning .message-icon {
    background-color: rgba(255, 170, 0, 0.3);
    border-color: rgba(255, 170, 0, 0.6);
    /* CSS animations not supported in Unity UI Toolkit */
    /* animation-name: pulse-icon-warning; */
    /* animation-duration: 1.5s; */
    /* animation-iteration-count: infinite; */
    /* animation-timing-function: ease-in-out; */
}

@keyframes pulse-icon-warning {
    0%, 100% {
        scale: 1;
        background-color: rgba(255, 170, 0, 0.3);
    }
    50% {
        scale: 1.1;
        background-color: rgba(255, 170, 0, 0.5);
    }
}

.message-card.warning .icon-text {
    color: rgb(255, 220, 120);
    font-size: 52px;
}

.message-card.warning .message-label {
    font-size: 38px;
    color: rgb(255, 255, 255);
}

/* === ERROR TYPE (Red) - CRITICAL VISIBILITY === */
.message-card.error {
    background-color: rgba(60, 10, 10, 0.98);
    border-left-color: rgb(239, 68, 68);
    border-color: rgba(239, 68, 68, 0.5);
    border-width: 4px;
    border-left-width: 12px;
    /* CSS animations not supported in Unity UI Toolkit - use C# animations instead */
    /* animation-name: pulse-error; */
    /* animation-duration: 1.5s; */
    /* animation-iteration-count: infinite; */
    /* animation-timing-function: ease-in-out; */
}

/* @keyframes not supported in Unity UI Toolkit */
/* @keyframes pulse-error {
    0%, 100% {
        border-left-color: rgb(239, 68, 68);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6), 0 0 0 0 rgba(239, 68, 68, 0.4);
    }
    50% {
        border-left-color: rgb(255, 100, 100);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6), 0 0 25px 8px rgba(239, 68, 68, 0.4);
    }
} */

.message-card.error .message-icon {
    background-color: rgba(239, 68, 68, 0.3);
    border-color: rgba(239, 68, 68, 0.6);
    /* CSS animations not supported in Unity UI Toolkit */
    /* animation-name: shake-icon; */
    /* animation-duration: 0.5s; */
    /* animation-iteration-count: infinite; */
    /* animation-timing-function: ease-in-out; */
}

/* @keyframes not supported in Unity UI Toolkit */
/* @keyframes shake-icon {
    0%, 100% {
        translate: 0 0;
        scale: 1;
    }
    25% {
        translate: -3px 0;
        scale: 1.05;
    }
    75% {
        translate: 3px 0;
        scale: 1.05;
    }
} */

.message-card.error .icon-text {
    color: rgb(252, 165, 165);
    font-size: 54px;
}

.message-card.error .message-label {
    font-size: 40px;
    color: rgb(255, 255, 255);
}

/* === AR HINT TYPE (Purple) === */
.message-card.ar-hint {
    background-color: rgba(35, 25, 50, 0.98);
    border-left-color: rgb(168, 85, 247);
    border-color: rgba(168, 85, 247, 0.3);
}

.message-card.ar-hint .message-icon {
    background-color: rgba(168, 85, 247, 0.2);
    border-color: rgba(168, 85, 247, 0.5);
}

.message-card.ar-hint .icon-text {
    color: rgb(216, 180, 254);
}
