/* ARSAFE Help Panel - MOBILE-FIRST DESIGN (Large Text)
 * Optimized for mobile phone screens with large, readable text
 */

/* ========== OVERLAY ========== */
.help-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    display: none;
}

/* ========== MAIN CARD ========== */
.help-card {
    width: 100%;
    height: 100%;
    background-color: rgb(245, 245, 245);
    flex-direction: column;
}

/* ========== HEADER ========== */
.help-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 40px 35px;
    min-height: 140px;
    background-color: rgb(30, 42, 71);
    border-bottom-width: 5px;
    border-bottom-color: rgb(255, 130, 0);
}

.help-header__title {
    font-size: 56px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    flex-grow: 1;
}

.help-close-button {
    width: 90px;
    height: 90px;
    font-size: 70px;
    color: rgb(255, 255, 255);
    background-color: rgba(255, 130, 0, 0.3);
    border-radius: 45px;
    border-width: 4px;
    border-color: rgb(255, 130, 0);
    padding: 0;
    margin-left: 25px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

/* ========== SCROLLABLE CONTENT ========== */
.help-content {
    flex-grow: 1;
    padding: 50px 40px;
    padding-bottom: 80px;
    background-color: rgb(245, 245, 245);
    overflow: hidden;
}

/* AGGRESSIVE SCROLLBAR HIDING - Multiple approaches to ensure complete removal */
.help-content .unity-scroller {
    width: 0;
    opacity: 0;
    display: none;
}

.help-content .unity-scroller--vertical {
    width: 0 !important;
    opacity: 0 !important;
    display: none !important;
}

.help-content .unity-scroller--horizontal {
    height: 0 !important;
    opacity: 0 !important;
    display: none !important;
}

.help-content > .unity-scroller--vertical {
    display: none;
}

.help-content > .unity-scroller--horizontal {
    display: none;
}

/* Hide vertical scroll container */
.help-content .unity-scroll-view__content-and-vertical-scroll-container .unity-scroller {
    width: 0;
    display: none;
}

/* ========== SECTIONS ========== */
.help-section {
    margin-bottom: 70px;
    flex-direction: column;
}

.help-section-title {
    font-size: 50px;
    color: rgb(30, 42, 71);
    -unity-font-style: bold;
    margin-bottom: 35px;
    padding-bottom: 18px;
    padding-left: 6px;
    border-bottom-width: 5px;
    border-bottom-color: rgb(255, 130, 0);
}

/* ========== Q&A BLOCKS ========== */
.help-qa {
    margin-bottom: 40px;
    padding: 35px;
    background-color: rgb(255, 255, 255);
    border-radius: 20px;
    flex-direction: column;
    border-left-width: 8px;
    border-left-color: rgb(255, 130, 0);
}

.help-question {
    font-size: 36px;
    color: rgb(30, 42, 71);
    -unity-font-style: bold;
    margin-bottom: 20px;
    white-space: normal;
}

.help-answer {
    font-size: 34px;
    color: rgb(60, 60, 60);
    white-space: normal;
}

/* ========== WARNING BOX ========== */
.help-warning-box {
    padding: 40px;
    background-color: rgba(255, 152, 0, 0.15);
    border-radius: 20px;
    border-left-width: 10px;
    border-left-color: rgb(255, 152, 0);
    flex-direction: column;
}

.help-warning-badge {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(30, 42, 71);
    margin-bottom: 18px;
}

.help-warning-text {
    font-size: 34px;
    color: rgb(40, 40, 40);
    white-space: normal;
}

/* ========== CONTACT ========== */
.help-contact-email {
    font-size: 38px;
    color: rgb(68, 138, 255);
    -unity-font-style: bold;
    margin-bottom: 18px;
}

.help-contact-note {
    font-size: 32px;
    color: rgb(100, 100, 100);
}

/* ========== FOOTER ========== */
.help-footer {
    padding: 35px 40px;
    background-color: rgb(30, 42, 71);
    border-top-width: 5px;
    border-top-color: rgb(255, 130, 0);
    align-items: center;
    justify-content: center;
}

.help-footer-text {
    font-size: 32px;
    color: rgb(255, 130, 0);
    -unity-font-style: bold;
}
